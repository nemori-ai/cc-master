          {
            "kind": "canonical-prose",
            "ref": "user-unknowns.md 先建框架"
          }
        ],
        "verifiers": [
          {
            "kind": "review",
            "ref": "issue-211.point.unknowns.frame-before-spec"
          }
        ]
      }
    },
    {
      "id": "point:unknowns.artifact-over-prose",
      "title": "具体物优于散文描述",
      "point_kind": "principle",
      "summary": "给能被指着说不对的具体物而不是描述，向用户与向执行者都适用；载体按 host 实际能力选，底线是真实代码加可跑样例。",
      "recognition_cues": [
        "准备用一段文字描述想要的效果",
        "要给执行者写验收标准",
        "不确定当前 host 支持什么形式的参照物"
      ],
      "binding": {
        "path": "plugin/src/knowledge/points/unknowns.artifact-over-prose.md",
        "marker": "point:unknowns.artifact-over-prose",
        "heading_hint": "能给具体物就别给描述"
      },
      "authority": {
