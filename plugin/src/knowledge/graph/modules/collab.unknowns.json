{
  "schema_version": "cc-master/skill-knowledge-source/v1alpha1",
  "kind": "module",
  "id": "module:collab.unknowns",
  "title": "与用户共构未知",
  "intent": "在目标模糊或地形不熟时，按未知的类型选择发现手法，把用户说不出口和压根没想到的东西挖出来，同时不对低风险可逆工作增加协作仪式。",
  "recognition_cues": [
    "用户给的是猜出来的方案而不是真实痛点",
    "对将要动的模块不熟、连该问什么都不知道",
    "用户说不清想要什么但看到就认得",
    "用户答不出什么样算好"
  ],
  "boundary": {
    "includes": [
      "四类未知的分派轴",
      "扫描/造物/提问/建框架的手法选择",
      "提问排序与停止判据",
      "具体物优于散文描述"
    ],
    "excludes": [
      "已表述假设的证据强度与证伪校准",
      "采访包的容器结构与时效校验",
      "目标成形检查表",
      "执行中的偏离留痕与验收后的理解校验",
      "同域其他协作主题（期望管理、讲解与教学）"
    ]
  },
  "access": {
    "class": "on_demand",
    "relevant_entries": [],
    "primary_points": [],
    "rationale": "只在目标模糊、地形不熟或用户偏好说不出口时 drill；四类未知齐备时不应触发。"
  },
  "lifecycle": {
    "state": "accepted",
    "since": "2026-07-28"
  },
  "admission": {
    "evidence": [
      {
        "kind": "canonical-prose",
        "ref": "plugin/src/skills/master-orchestrator-guide/canonical/references/user-unknowns.md"
      },
      {
        "kind": "research",
        "ref": "issue-211 source material: field guide on finding your unknowns",
        "note": "四象限与手法分派来自外部实践，经边界对账后只吸收 harness-neutral 部分"
      }
    ],
    "verifiers": [
      {
        "kind": "review",
        "ref": "issue-211.module.collab.unknowns"
      }
    ]
  },
  "points": [
    {
      "id": "point:unknowns.four-quadrants",
      "title": "四类未知与地图/地形差",
      "point_kind": "principle",
      "summary": "表示不是工作本身，二者之差即未知；模型越强这个差越危险，四类未知是你的内部分派轴而非对用户的话术。",
      "recognition_cues": [
        "推进得异常顺畅却说不出验证过什么",
        "需要判断当前缺的是哪一类未知",
        "想对用户使用未知分类术语"
      ],
      "binding": {
        "path": "plugin/src/knowledge/points/unknowns.four-quadrants.md",
        "marker": "point:unknowns.four-quadrants",
        "heading_hint": "地图不是那片地"
      },
      "authority": {
        "role": "canonical",
        "subject": "subject:unknowns.four-quadrants"
      },
      "lifecycle": {
        "state": "accepted",
        "since": "2026-07-28"
      },
      "admission": {
        "evidence": [
          {
            "kind": "canonical-prose",
            "ref": "user-unknowns.md 地图不是那片地"
          }
        ],
        "verifiers": [
          {
            "kind": "review",
            "ref": "issue-211.point.unknowns.four-quadrants"
          }
        ]
      }
    },
    {
      "id": "point:unknowns.technique-routing",
      "title": "按未知类型分派发现手法",
      "point_kind": "decision_rule",
      "summary": "扫描地形治未知的未知、造多方向的物治未知的已知、提问治已知的未知；四类都不缺就直接推进不加仪式。",
      "recognition_cues": [
        "不确定该扫描、造物还是直接问",
        "想对一个可逆小改增加访谈或原型",
        "需要对用户说明接下来要做什么"
      ],
      "binding": {
        "path": "plugin/src/knowledge/points/unknowns.technique-routing.md",
        "marker": "point:unknowns.technique-routing",
        "heading_hint": "按未知的类型选手法，不是走一套通用流程"
      },
      "authority": {
        "role": "canonical",
        "subject": "subject:unknowns.technique-routing"
      },
      "lifecycle": {
        "state": "accepted",
        "since": "2026-07-28"
      },
      "admission": {
        "evidence": [
          {
            "kind": "canonical-prose",
            "ref": "user-unknowns.md 手法分派与用户侧措辞"
          }
        ],
        "verifiers": [
          {
            "kind": "review",
            "ref": "issue-211.point.unknowns.technique-routing"
          }
        ]
      }
    },
    {
      "id": "point:unknowns.interview-discipline",
      "title": "提问纪律与停止判据",
      "point_kind": "procedure",
      "summary": "一次一个问题，按会不会改变架构、数据模型、流程、范围或验收排序，每答一次重选下一问；剩余未知不再改变方案形状就停。",
      "recognition_cues": [
        "准备向用户提问",
        "想一次抛出多个问题",
        "不知道还该不该继续问"
      ],
      "binding": {
        "path": "plugin/src/knowledge/points/unknowns.interview-discipline.md",
        "marker": "point:unknowns.interview-discipline",
        "heading_hint": "提问纪律：一次一个，按会不会改方案排序"
      },
      "authority": {
        "role": "canonical",
        "subject": "subject:unknowns.interview-discipline"
      },
      "lifecycle": {
        "state": "accepted",
        "since": "2026-07-28"
      },
      "admission": {
        "evidence": [
          {
            "kind": "canonical-prose",
            "ref": "user-unknowns.md 提问纪律"
          }
        ],
        "verifiers": [
          {
            "kind": "review",
            "ref": "issue-211.point.unknowns.interview-discipline"
          }
        ]
      }
    },
    {
      "id": "point:unknowns.frame-before-spec",
      "title": "用户没有判断框架时先建框架",
      "point_kind": "decision_rule",
      "summary": "用户答不出什么样算好时，先讲清取舍轴并给对照实例帮他定位，绝不反复把需求抛回给一个还没有判断框架的人。",
      "recognition_cues": [
        "用户在这个领域缺乏经验",
        "反复追问却拿不到有效答案",
        "想索要一份并不存在的完整规格"
      ],
      "binding": {
        "path": "plugin/src/knowledge/points/unknowns.frame-before-spec.md",
        "marker": "point:unknowns.frame-before-spec",
        "heading_hint": "用户没有判断框架时：先建框架，别索要 spec"
      },
      "authority": {
        "role": "canonical",
        "subject": "subject:unknowns.frame-before-spec"
      },
      "lifecycle": {
        "state": "accepted",
        "since": "2026-07-28"
      },
      "admission": {
