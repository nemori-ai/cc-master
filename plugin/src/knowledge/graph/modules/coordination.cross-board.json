{
  "schema_version": "cc-master/skill-knowledge-source/v1alpha1",
  "kind": "module",
  "id": "module:coordination.cross-board",
  "title": "跨编排的消费侧",
  "intent": "教多编排并行时怎么读中介建议、何时读、算什么重叠，以及竞争同一个人时怎么把顺序代价交上去。",
  "recognition_cues": [
    "还有别的编排在跑",
    "收件箱里的通知没人读",
    "几块板都在等同一个人"
  ],
  "boundary": {
    "includes": [
      "花名册与收件箱的消费触发点",
      "同侪重叠面的三个维度",
      "跨板用户关口的顺序建议"
    ],
    "excludes": [
      "编排者之间的点对点协商",
      "中介如何计算建议",
      "单板内的决策包组织"
    ]
  },
  "access": {
    "class": "on_demand",
    "relevant_entries": [
      "entry:master-orchestrator"
    ],
    "primary_points": [
      "point:coordination.advisory-consumption"
    ],
    "rationale": "侦察步发现有同侪在跑、或收件箱有未处理通知时召回。"
  },
  "lifecycle": {
    "state": "draft",
    "since": "2026-08-05",
    "rationale": "知识先立、skill 后组：消费侧零指导已由真实编排记录证实，但归入哪个 skill 待结构重排时统一决定。"
  },
