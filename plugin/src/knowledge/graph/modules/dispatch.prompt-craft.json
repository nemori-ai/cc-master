{
  "schema_version": "cc-master/skill-knowledge-source/v1alpha1",
  "kind": "module",
  "id": "module:dispatch.prompt-craft",
  "title": "派发 prompt 的道与红线",
  "intent": "教契约字段之外的正文该长什么形状、约束到什么程度算刚好、哪几条绝不能写与绝不能省。",
  "recognition_cues": [
    "派发单该写多细",
    "要不要把实现方案写进派发指令",
    "worker 做偏了是不是没说清楚"
  ],
  "boundary": {
    "includes": [
      "派发正文的五块形状",
      "补信息与替它判断的分界",
      "绝不能写与绝不能省的清单"
    ],
    "excludes": [
      "契约必须含哪些字段",
      "面向特定模型的措辞结构偏好",
      "该不该派发这件事"
    ]
  },
  "access": {
    "class": "on_demand",
    "relevant_entries": [
      "entry:master-orchestrator"
    ],
    "primary_points": [
      "point:dispatch.prompt-shape"
    ],
    "rationale": "写派发 prompt 时召回。"
  },
  "lifecycle": {
    "state": "draft",
    "since": "2026-08-05",
    "rationale": "知识先立、skill 后组：内容轴指定的落点是既有派发链上的点而非新模块，但那些模块已被 composition 消费，加点要同步文章清单。故先以 draft 模块立住，归并到派发链留到结构重排时一并做。"
  },
  "admission": {
    "evidence": [
      {
        "kind": "canonical-prose",
        "ref": "module:dispatch.prompt-craft"
      }
    ],
    "verifiers": [
