          {
            "kind": "golden",
            "ref": "golden.point.dispatch.prompt-calibration"
          }
        ]
      }
    },
    {
      "id": "point:dispatch.prompt-red-lines",
      "title": "派发 prompt 的最小约束红线",
      "point_kind": "boundary",
      "failure_mode": "motivation_conflict",
      "summary": "绝不能写：已想好的方案分解、凭据与原始输入、未经验证的事实；绝不能省：可自证的完成判据、求助条件、并行隔离位置、最小背景。钉死方案是指挥不演奏的隐蔽违反——问一句「若执行者比你更懂，哪句会挡它的路」。",
      "recognition_cues": [
        "派发单里什么绝对不能写",
        "把方案写死给 worker 行不行"
      ],
      "binding": {
