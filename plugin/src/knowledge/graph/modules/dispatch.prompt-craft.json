  },
  "points": [
    {
      "id": "point:dispatch.prompt-shape",
      "title": "派发 prompt 该长什么形状",
      "point_kind": "principle",
      "failure_mode": "motivation_conflict",
      "summary": "给目标和判据不给步骤和方案；背景/目标/边界/自证/求助条件五块；分界是它拿不到还是它做不到——删了会做错的是信息，删了只是做法不同的是你的偏好。",
      "recognition_cues": [
        "派发单正文写什么",
        "要不要把步骤列给 worker"
      ],
      "binding": {
        "path": "plugin/src/knowledge/points/dispatch.prompt-shape.md",
        "marker": "point:dispatch.prompt-shape",
        "heading_hint": "派发 prompt 该长什么形状"
